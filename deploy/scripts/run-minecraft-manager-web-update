#!/usr/bin/env bash
set -euo pipefail
[[ $EUID -eq 0 ]] || exit 1
state_dir=/var/lib/minecraft-manager
# No arguments or commands are read from the request file.
if [[ "${1:-}" == "--finish" ]]; then
  # systemd runs this even after a crash or timeout of the updater.
  temporary="$(mktemp "$state_dir/.update-status.XXXXXX")"
  if [[ "${SERVICE_RESULT:-failed}" == "success" ]]; then
    printf '{"state":"succeeded","message":"Manager is up to date."}\n' >"$temporary"
  else
    printf '{"state":"failed","message":"Update failed. See journalctl -u mc-manager-update.service for details."}\n' >"$temporary"
  fi
  chmod 0644 "$temporary"
  mv -fT "$temporary" "$state_dir/manager-update-status.json"
  rm -f "$state_dir/manager-update.request"
  exit 0
fi
# Requests are fixed commands selected by the authenticated dashboard.
request="$state_dir/manager-update.request"
[[ -f "$request" && ! -L "$request" ]] || { echo "Missing update request" >&2; exit 1; }
scope="$(cat "$request")"
case "$scope" in
  update) exec /usr/local/sbin/update-minecraft-manager ;;
  fleet)
    [[ -s /etc/minecraft-manager/fleet ]] || { echo "No fleet configured" >&2; exit 1; }
    exec /usr/local/bin/update-minecraft-manager-fleet
    ;;
  *) echo "Unknown update request" >&2; exit 2 ;;
esac
